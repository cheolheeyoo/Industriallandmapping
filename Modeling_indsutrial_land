// Import required library
var oeel = require('users/OEEL/lib:loadAll');

// Define year and initialize variables
var year = 2020;
var regionCol = ee.FeatureCollection("projects/ee-indmapping/assets/1093_IND_1723_shapefile/1093_urban_boundary_rect_cluster43");

// Circle kernel sizes for texture analysis
var cirall = [10, 10, 50, 20, 20, 10, 50, 20, 30, 20, 40, 20, 10, 40, 20, 40, 20, 10, 40, 20, 50, 50, 50, 40, 50, 50, 30, 40, 30, 40, 10, 20, 10, 30, 40, 10, 40, 20, 40, 10, 50, 30, 20];

// Iterate through all clusters (43 in total)
for (var i = 0; i < 43; i++) {
  var cir = cirall[i];
  var cluster = i + 1;

  // Filter region by cluster
  var total_region = regionCol.filter(ee.Filter.eq('Cluster43', cluster));

  // Load training and testing points
  var trainpt = ee.FeatureCollection("projects/ee-indmapping/assets/1093_IND_1723_shapefile/Train_cluster_43_2025")
    .filterBounds(total_region.geometry());
  var testpt = ee.FeatureCollection("projects/ee-indmapping/assets/1093_IND_1723_shapefile/Test_cluster_43_final")
    .filterBounds(total_region.geometry());

  // Define date range
  var startDate = year + '-01-01';
  var endDate = year + '-12-31';

  // World Settlement Footprint (WSF) processing
  var WSF = ee.ImageCollection("projects/sat-io/open-datasets/landcover/ESRI_Global-LULC_10m_TS")
    .filterDate(startDate, endDate);
  var WSF4 = WSF.mosaic()
    .reproject({ crs: 'EPSG:4326', scale: 10 })
    .eq(7)
    .clip(total_region);
  var WSFbuffer = ee.Image(1)
    .cumulativeCost({ source: WSF4, maxDistance: 120 })
    .lt(120)
    .gte(0);

  // Sentinel-2 harmonized collection with cloud masking
  var l8 = ee.ImageCollection('COPERNICUS/S2_HARMONIZED');
  var csPlus = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');
  var QA_BAND = 'cs_cdf';
  var CLEAR_THRESHOLD = 0.60;

  var l8FiltMasked = l8.filterBounds(total_region)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 30))
    .linkCollection(csPlus, [QA_BAND])
    .map(function (img) {
      return img.updateMask(img.select(QA_BAND).gte(CLEAR_THRESHOLD));
    });

  var l8compositeMasked = l8FiltMasked.median().clip(total_region);

  // Add bands (Sentinel-2 bands, nighttime lights, elevation data, texture features, etc.)
  var band = l8compositeMasked.select(['B2']).unmask(-1).rename(['B1'])
    .addBands(l8compositeMasked.select(['B3']).unmask(-1).rename(['B2']))
    .addBands(l8compositeMasked.select(['B4']).unmask(-1).rename(['B3']))
    .addBands(l8compositeMasked.select(['B5']).unmask(-1).rename(['B4']))
    .addBands(l8compositeMasked.select(['B6']).unmask(-1).rename(['B5']))
    .addBands(l8compositeMasked.select(['B7']).unmask(-1).rename(['B6']))
    .addBands(l8compositeMasked.select(['B8']).unmask(-1).rename(['B7']))
    .addBands(l8compositeMasked.select(['B8A']).unmask(-1).rename(['B8']))
    .addBands(l8compositeMasked.select(['B11']).unmask(-1).rename(['B9']))
    .addBands(l8compositeMasked.select(['B12']).unmask(-1).rename(['B10']));

  // Add nighttime lights (VIIRS)
  var nighttime = ee.ImageCollection('NOAA/VIIRS/DNB/MONTHLY_V1/VCMSLCFG')
    .filter(ee.Filter.date(startDate, endDate))
    .select('avg_rad')
    .median()
    .reproject({ crs: 'EPSG:4326', scale: 10 })
    .unmask(-1)
    .clip(total_region);
  band = band.addBands(nighttime.rename(['B36']));

  // Add elevation data (FABDEM)
  var fabdem = ee.ImageCollection("projects/sat-io/open-datasets/FABDEM")
    .mosaic()
    .clip(total_region)
    .reproject({ crs: 'EPSG:4326', scale: 10 })
    .unmask(-1);
  band = band.addBands(fabdem.rename(['B42']));

  // Add texture features (GLCM)
  var texture3 = l8compositeMasked.multiply(10000).toInt().glcmTexture({ size: cir });
  band = band.addBands(texture3.select(['B2_contrast']).unmask(-1).rename(['B50']))
    .addBands(texture3.select(['B3_contrast']).unmask(-1).rename(['B51']))
    .addBands(texture3.select(['B4_contrast']).unmask(-1).rename(['B52']))
    .addBands(texture3.select(['B8_contrast']).unmask(-1).rename(['B53']));

  // Add latitude and longitude
  var lonImage = ee.Image.pixelLonLat().select('longitude')
    .reproject({ crs: 'EPSG:4326', scale: 10 });
  var latImage = ee.Image.pixelLonLat().select('latitude')
    .reproject({ crs: 'EPSG:4326', scale: 10 });
  band = band.addBands(lonImage.rename(['B65']))
    .addBands(latImage.rename(['B66']));

  // Add built-up data (GHSL)
  var builtSurface = ee.Image('JRC/GHSL/P2023A/GHS_BUILT_S/2020')
    .select(['built_surface_nres'])
    .reproject({ crs: 'EPSG:4326', scale: 10 })
    .unmask(-1);
  var builtVolume = ee.Image('JRC/GHSL/P2023A/GHS_BUILT_V/2020')
    .select(['built_volume_nres'])
    .reproject({ crs: 'EPSG:4326', scale: 10 })
    .unmask(-1);
  band = band.addBands(builtSurface.rename(['B68']))
    .addBands(builtVolume.rename(['B71']));

  // Mask WSF buffer
  var imageCl = band.updateMask(WSFbuffer);

  // Train a random forest classifier
  var training = imageCl.sampleRegions({
    collection: trainpt,
    properties: ['class'],
    scale: 10,
    tileScale: 16
  }).filter(ee.Filter.neq('B1', -1));
  var trainedRf = ee.Classifier.smileRandomForest({ numberOfTrees: 500 })
    .train({
      features: training,
      classProperty: 'class',
      inputProperties: band.bandNames()
    });

  // Classify image
  var classifiedRf = imageCl.classify(trainedRf);

  // Validate the classifier
  var validation = imageCl.sampleRegions({
    collection: testpt,
    properties: ['class'],
    scale: 10,
    tileScale: 16
  }).filter(ee.Filter.neq('B1', -1));
  var validatedRf = validation.classify(trainedRf);
  var validationAccuracyRf = validatedRf.errorMatrix('class', 'classification');

  print('Cluster', cluster, 'RF Accuracy:', validationAccuracyRf.accuracy());
  print('Cluster', cluster, 'Error Matrix:', validationAccuracyRf);

  // Export validation results
  var clustersave = String(cluster).padStart(3, '0');
  Export.table.toDrive({
    collection: ee.FeatureCollection(validatedRf),
    description: 'Validation_Cluster43_' + clustersave,
    folder: 'Cluster_43_Validation_' + year,
    fileFormat: 'CSV'
  });

  // Export classified image
  Export.image.toAsset({
    image: classifiedRf,
    description: 'Classified_Cluster43_' + clustersave,
    assetId: 'Cluster43_Classified_' + clustersave,
    region: total_region.geometry(),
    scale: 10,
    crs: 'EPSG:4326',
    maxPixels: 1e13
  });
}
